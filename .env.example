# ==============================================================================
# QuantumEdge Pipeline - environment variables
# Copy to .env and adjust for your machine. These are local demo values.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application
# ------------------------------------------------------------------------------
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production-use-strong-random-key

# Active deployment profile: edge (default) or datacenter
QUANTUMEDGE_PROFILE=edge

# ------------------------------------------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=quantumedge
POSTGRES_USER=qe_user
# Local demo password only; never reuse in production
POSTGRES_PASSWORD=qe_pass

# ------------------------------------------------------------------------------
# API
# ------------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8501"]

# ------------------------------------------------------------------------------
# Quantum simulator
# ------------------------------------------------------------------------------
QUANTUM_BACKEND=simulator
QUANTUM_SHOTS=1000
QUANTUM_NOISE_MODEL=none
MAX_QUBITS=20
QUANTUM_OPTIMIZATION_LEVEL=2
QUANTUM_DEPOLARIZING_ERROR=0.001
QUANTUM_T1_RELAXATION=50.0
QUANTUM_T2_DEPHASING=70.0

# Optional: photonic cloud API key. If unset, the backend runs in mock mode.
QUANTUM_CLOUD_API_KEY=

# ------------------------------------------------------------------------------
# Edge environment
# ------------------------------------------------------------------------------
EDGE_DEFAULT_PROFILE=aerospace
EDGE_POWER_BUDGET_WATTS=50
EDGE_THERMAL_LIMIT_CELSIUS=85
EDGE_MEMORY_MB=4096
EDGE_CPU_CORES=4
EDGE_MAX_EXECUTION_TIME_SEC=300

# ------------------------------------------------------------------------------
# Router thresholds
# ------------------------------------------------------------------------------
ROUTER_CLASSICAL_THRESHOLD=100
ROUTER_QUANTUM_THRESHOLD=1000
ROUTER_HYBRID_ENABLED=true
ROUTER_MIN_QUANTUM_ADVANTAGE=1.2
ROUTER_MAX_ENERGY_RATIO=2.0
ROUTER_SPARSE_PREFERENCE=0.3
